---
import Layout from '../layouts/Layout.astro';
import TarjetaTaller from '../components/TarjetaTaller.astro';
const talleresDestacados = [
  { nombre: "Fotografía", descripcion: "Explora la luz y captura historias con tu cámara.", imagen: "/img/fotografia.svg", informacion: "Aprende encuadre, composición y manejo de luz con ejercicios prácticos. No necesitas experiencia previa: puedes comenzar con una cámara digital o tu teléfono." },
  { nombre: "Cerámica", descripcion: "Da forma a tus ideas trabajando con arcilla.", imagen: "/img/ceramica.svg", informacion: "Conoce técnicas básicas de modelado a mano y crea piezas decorativas y funcionales. El taller acompaña cada proyecto desde la primera forma hasta sus acabados." },
  { nombre: "Escritura creativa", descripcion: "Encuentra nuevas maneras de contar tus historias.", imagen: "/img/escritura.svg", informacion: "Practica escritura libre, creación de personajes y relatos breves. Compartimos ejercicios en un ambiente abierto para desarrollar tu propia voz." }
];
---
<Layout title="Espacio Cultural - Inicio">
  <section class="hero"><h1>Bienvenidos a Espacio Cultural</h1><p>Un punto de encuentro comunitario dedicado al desarrollo artístico y al aprendizaje colaborativo.</p></section>
  <section><h2>Talleres Destacados</h2><div class="tarjetas-grid">
    {talleresDestacados.map((taller) => <TarjetaTaller nombre={taller.nombre} descripcion={taller.descripcion} imagen={taller.imagen} informacion={taller.informacion} />)}
  </div></section>
</Layout>
