---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Espacio Cultural - Nosotros">
  <section class="nosotros-container">
    <div class="nosotros-texto">
      <h1>Sobre Nuestra Organización</h1>
      <p>
        <strong>Espacio Cultural</strong> tiene como propósito promover el acceso universal a la cultura y las artes, fomentando un entorno inclusivo donde la comunidad puede explorar y desarrollar su talento creativo.
      </p>
    </div>
    <div class="nosotros-imagen">
      <img src="/img/nosotros.svg" alt="Espacio Cultural" />
    </div>
  </section>
</Layout>